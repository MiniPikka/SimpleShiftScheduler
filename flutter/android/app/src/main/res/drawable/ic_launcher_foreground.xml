<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
    Three S-shaped ribbons in a triskelion pattern (120° rotation).
    Each S represents one word of "Simple Shift Scheduler"
    and the rotation evokes shift cycling.
    -->

    <!-- Arm 1 (0°) - Amber (#FF8F00) — "Simple" / morning shift -->
    <group android:rotation="0" android:pivotX="54" android:pivotY="54">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FF8F00"
            android:strokeWidth="7.5"
            android:strokeLineCap="round"
            android:pathData="M54,49 C66,49 66,40 54,38 C42,36 42,26 54,24"/>
    </group>

    <!-- Arm 2 (120°) - Teal (#26A69A) — "Shift" / swing shift -->
    <group android:rotation="120" android:pivotX="54" android:pivotY="54">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#26A69A"
            android:strokeWidth="7.5"
            android:strokeLineCap="round"
            android:pathData="M54,49 C66,49 66,40 54,38 C42,36 42,26 54,24"/>
    </group>

    <!-- Arm 3 (240°) - Violet (#7E57C2) — "Scheduler" / night shift -->
    <group android:rotation="240" android:pivotX="54" android:pivotY="54">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#7E57C2"
            android:strokeWidth="7.5"
            android:strokeLineCap="round"
            android:pathData="M54,49 C66,49 66,40 54,38 C42,36 42,26 54,24"/>
    </group>

    <!-- Central circle — ties the three S arms together -->
    <path
        android:fillColor="#ECEFF1"
        android:pathData="M54,54 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 Z"/>

</vector>
